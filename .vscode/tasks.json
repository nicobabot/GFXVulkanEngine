{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build engine (Debug x64)",
            "type": "process",
            "command": "C:/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/MSBuild.exe",
            "args": [
                "${workspaceFolder}/GFXVulkanEngine.sln",
                "/m",
                "/t:Build",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/verbosity:minimal"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
