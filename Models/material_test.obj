# Three adjacent panels in one shape, with three material runs.
mtllib material_test.mtl
o material_panels
v -1.5 0 0
v -0.5 0 0
v 0.5 0 0
v 1.5 0 0
v -1.5 1 0
v -0.5 1 0
v 0.5 1 0
v 1.5 1 0
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0 0 -1
usemtl red
f 1/1/1 5/4/1 6/3/1 2/2/1
usemtl green
f 2/1/1 6/4/1 7/3/1 3/2/1
usemtl textured
f 3/1/1 7/4/1 8/3/1 4/2/1
